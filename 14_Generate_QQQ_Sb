# =============================================================================
# SHARED — VALIDATORS & FILE LOADING
# =============================================================================

def validate_excel_file(path: str) -> tuple[bool, str]:
    """
    Confirm the file has both required sheets and all required columns.
    Returns (is_valid, error_message). error_message is empty when valid.
    """
    try:
        xl = pd.ExcelFile(path)
    except Exception as exc:
        return False, f"Could not open file:\n{exc}"

    # Check both sheets are present
    missing_sheets = [s for s in _SHEET_COLUMNS if s not in xl.sheet_names]
    if missing_sheets:
        names = "\n".join(f"  • {s}" for s in missing_sheets)
        return False, f"The following required sheet(s) are missing from the file:\n\n{names}"

    # Check required columns in each sheet (header row only — no data loaded)
    column_errors: list[str] = []
    for sheet, required in _SHEET_COLUMNS.items():
        actual = list(pd.read_excel(xl, sheet_name=sheet, nrows=0).columns)
        missing = [c for c in required if c not in actual]
        if missing:
            cols = "\n".join(f"    • {c}" for c in missing)
            column_errors.append(
                f"Sheet '{sheet}' is missing {len(missing)} required column(s):\n{cols}"
            )

    if column_errors:
        return False, "Column validation failed:\n\n" + "\n\n".join(column_errors)

    return True, ""


def load_sheets(path: str) -> dict[str, pd.DataFrame]:
    """
    Load PRAC and FAC sheets trimmed to required columns in defined order.
    Columns in _TEXT_AS_IS_COLUMNS are forced to dtype=str at read time so
    leading zeros (e.g. SpecialtyCode 001) are never lost.
    Always call validate_excel_file first.
    """
    xl = pd.ExcelFile(path)
    result = {}
    for sheet, required in _SHEET_COLUMNS.items():
        dtype_map = {col: str for col in required if col in _TEXT_AS_IS_COLUMNS}
        df = pd.read_excel(xl, sheet_name=sheet, dtype=dtype_map)
        result[sheet] = df[required]
    return result


# =============================================================================
# SHARED — STANDARDIZATION
# =============================================================================

# Columns that must stay as text to preserve leading zeros
_TEXT_AS_IS_COLUMNS = {"#REFFF"}


def standardize_sheet(df: pd.DataFrame) -> pd.DataFrame:
    """
    Clean a single sheet in-place (returns a new DataFrame):
      1. Keep only the required columns (already done by load_sheets).
      2. Convert every column to string, preserving leading zeros for
         text-as-is columns by reading them as str before any coercion.
      3. Trim leading/trailing whitespace.
      4. Uppercase all text.
      5. Replace 'NAN' / 'NONE' strings (pandas artefacts) back to blank.
    """
    result = df.copy()
    for col in result.columns:
        # Convert to object/string — blanks become the literal 'nan' from pandas
        result[col] = result[col].astype(str)
        result[col] = result[col].str.strip().str.upper()
        # Restore blanks: pandas converts NaN → 'NAN' after astype(str)
        result[col] = result[col].replace({"NAN": "", "NONE": "", "NAT": ""})
    return result


def standardize_sheets(sheets: dict[str, pd.DataFrame]) -> dict[str, pd.DataFrame]:
    """Apply standardize_sheet to every sheet in the dict."""
    return {name: standardize_sheet(df) for name, df in sheets.items()}
