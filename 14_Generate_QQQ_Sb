import pandas as pd

# Define your data
data = {
    "Name": ["Alice", "Bob", "Charlie"],
    "Age": [25, 30, 35],
    "Department": ["IT", "HR", "Finance"]
}

# Convert data into a DataFrame (table)
df = pd.DataFrame(data)

# Save to Excel
df.to_excel("employees.xlsx", index=False)
print("File 'employees.xlsx' created successfully!")
