DPI = 400                 # render resolution for OCR / mark detection
SCALE = DPI / 72.0
INK_DIFF = 80             # how much darker than the template a pixel must be to count as ink
CHECK_MIN_PIXELS = 60     # ink pixels (at DPI) needed to call a checkbox ticked
CHECK_SEARCH_PT = 9       # how far (points) from a box an offset tick may sit
FILL_RATIO = 0.35         # share of a box's interior covered in ink => filled-in box = checked
TEXT_MIN_PIXELS = 40      # ink pixels inside a text field before we bother OCR-ing it
SINGLE_CHAR_FIELDS = {"owner_middle_initial"}
EXCLUSIVE_PAIRS = [("new_enrollment", "update_enrollment"), ("gender_male", "gender_female")]

# Cyrillic/Greek look-alikes OCR sometimes returns for Latin letters.
HOMOGLYPHS = str.maketrans("АВСЕНІЈКМОРЅТХУаеорсухіјΑΒΕΗΙΚΜΝΟΡΤΧΥΖ",
                           "ABCEHIJKMOPSTXYaeopcyxijABEHIKMNOPTXYZ")
DIGIT_FIX = str.maketrans({"O": "0", "o": "0", "D": "0", "Q": "0", "I": "1", "l": "1", "|": "1",
                           "i": "1", "!": "1", "S": "5", "s": "5", "B": "8", "Z": "2", "z": "2",
                           "G": "6", "b": "6", "g": "9", "q": "9"})



def _load_words():
    # English word list used to re-join split OCR words; ships next to the script.
    try:
        with open(os.path.join(BASE_DIR, "words.txt"), encoding="utf-8", errors="ignore") as f:
            return {w.strip().lower() for w in f if w.strip()}
    except OSError:
        return set()


WORDS = _load_words()
DOMAIN_WORDS = ["enrollment", "enrollments", "update", "updated", "provider", "address", "county",
                "counties", "services", "information", "telephone", "ownership", "agency"]
WORDS |= set(DOMAIN_WORDS) | {"n/a", "email", "phone", "fax"}
EMAIL_DOMAINS = ["example.com", "gmail.com", "yahoo.com", "outlook.com", "hotmail.com", "aol.com",
                 "icloud.com", "live.com", "msn.com", "comcast.net", "att.net", "sbcglobal.net"]


# ================================================================ rendering
def _to_array(pix):
    return np.frombuffer(pix.samples, dtype=np.uint8).reshape(pix.height, pix.width).astype(np.int16)


def render_gray(page, dpi=DPI, annots=False):
    return _to_array(page.get_pixmap(dpi=dpi, colorspace=pymupdf.csGRAY, annots=annots))


def normalize_paper(img):
    """Lift the paper to white (handles gray/yellow scans) without darkening printed lines."""
    paper = np.percentile(img, 90)
    if paper >= 250 or paper < 120:
        return img
    out = img.astype(np.float32) * (255.0 / paper)
    return np.clip(out, 0, 255).astype(np.int16)


def fit_shape(img, shape, zoom=None):
    """Scale img (keeping aspect ratio, by width unless zoom is given) and pad/crop it to shape."""
    if img.shape == shape and zoom is None:
        return img
    z = zoom if zoom is not None else shape[1] / img.shape[1]
    if abs(z - 1) > 0.002:
        img = ndimage.zoom(img.astype(np.float32), z, order=1).astype(np.int16)
    h, w = shape
    img = np.pad(img, ((0, max(0, h - img.shape[0])), (0, max(0, w - img.shape[1]))), constant_values=255)
    return img[:h, :w]


# ================================================================ alignment
def _ink(img):
    a = 255.0 - img.astype(np.float32)
    return a - a.mean()


def _xcorr(a, b):
    """Return (peak score, dy, dx) of the best translation of a onto b."""
    c = np.fft.irfft2(np.fft.rfft2(a) * np.conj(np.fft.rfft2(b)), s=a.shape)
    dy, dx = np.unravel_index(np.argmax(c), c.shape)
    score = c[dy, dx] / (np.linalg.norm(a) * np.linalg.norm(b) + 1e-9)
    if dy > a.shape[0] // 2:
        dy -= a.shape[0]
    if dx > a.shape[1] // 2:
        dx -= a.shape[1]
    return float(score), int(dy), int(dx)


def align(scan, tpl, extra=None):
    """Rotate (90-steps + fine skew), resize and shift scan onto the template grid.
    Returns (aligned_scan, info_dict). `extra` (same size as scan, white = 255) gets the
    identical transform and comes back as info["extra"]."""
    step = 8
    tpl_small = tpl[::step, ::step]
    tb = _ink(tpl_small)

    # Coarse orientation.
    best = None
    for k in range(4):
        cand = fit_shape(np.rot90(scan, k)[::step, ::step], tpl_small.shape)
        score = _xcorr(_ink(cand), tb)[0]
        if best is None or score > best[0]:
            best = (score, k)
    k = best[1]
    scan = fit_shape(np.rot90(scan, k), tpl.shape)
    if extra is not None:
        extra = fit_shape(np.rot90(extra, k), tpl.shape)

    # Scale: scanners/printers often shrink the page ("fit to page", A4 vs Letter).
    step = 4
    tpl_small = tpl[::step, ::step]
    tb = _ink(tpl_small)
    base_small = scan[::step, ::step]
    best_zoom, best_score = 1.0, -1
    for z in np.arange(0.88, 1.121, 0.01):
        s = _xcorr(_ink(fit_shape(base_small, tpl_small.shape, zoom=z)), tb)[0]
        if s > best_score + 1e-4:
            best_zoom, best_score = float(z), s
    for z in np.arange(best_zoom - 0.008, best_zoom + 0.0081, 0.002):
        s = _xcorr(_ink(fit_shape(base_small, tpl_small.shape, zoom=z)), tb)[0]
        if s > best_score + 1e-4:
            best_zoom, best_score = float(z), s
    if abs(best_zoom - 1) > 0.001:
        scan = fit_shape(scan, tpl.shape, zoom=best_zoom)
        if extra is not None:
            extra = fit_shape(extra, tpl.shape, zoom=best_zoom)

    # Fine skew: try small angles on a reduced image.
    small = scan[::step, ::step].astype(np.float32)
    best_angle, best_score = 0.0, -1
    for angle in np.arange(-3.0, 3.01, 0.25):
        rot = small if angle == 0 else ndimage.rotate(small, angle, reshape=False, order=1, cval=255)
        s = _xcorr(_ink(rot), tb)[0]
        if s > best_score + 1e-4:
            best_angle, best_score = float(angle), s
    best_score = max(best_score, 0)
    if best_angle:
        scan = ndimage.rotate(scan.astype(np.float32), best_angle, reshape=False, order=1, cval=255).astype(np.int16)
        if extra is not None:
            extra = ndimage.rotate(extra.astype(np.float32), best_angle, reshape=False, order=1, cval=255).astype(np.int16)

    # Translation at full resolution precision (estimated at step 2, refined locally).
    _, dy, dx = _xcorr(_ink(scan[::2, ::2]), _ink(tpl[::2, ::2]))
    dy, dx = dy * 2, dx * 2
    scan = ndimage.shift(scan, (-dy, -dx), order=0, cval=255)
    if extra is not None:
        extra = ndimage.shift(extra, (-dy, -dx), order=0, cval=255)
    scan, extra = local_align(scan, tpl, extra)
    match = _xcorr(_ink(scan[::4, ::4]), tb)[0]
    return scan, {"extra": extra, "rotation90": k * 90, "scale": round(best_zoom, 3), "skew_deg": best_angle,
                  "shift_px": (dy, dx), "match": round(match, 3)}


def local_align(scan, tpl, extra=None, tile=360, search=14):
    """Fine-tune alignment tile by tile (absorbs leftover skew, scale and paper warp)."""
    h, w = tpl.shape
    ny, nx = (h + tile - 1) // tile, (w + tile - 1) // tile
    shifts = np.zeros((ny, nx, 2))
    valid = np.zeros((ny, nx), bool)
    for iy in range(ny):
        for ix in range(nx):
            y0, x0 = iy * tile, ix * tile
            t = tpl[y0:y0 + tile, x0:x0 + tile]
            if (t < 128).mean() < 0.01:                     # tile has almost no printed structure
                continue
            sc = scan[y0:y0 + tile, x0:x0 + tile]
            a, b = _ink(sc), _ink(t)
            c = np.fft.irfft2(np.fft.rfft2(a) * np.conj(np.fft.rfft2(b)), s=a.shape)
            c = np.roll(np.roll(c, search, 0), search, 1)[:2 * search + 1, :2 * search + 1]
            dy, dx = np.unravel_index(np.argmax(c), c.shape)
            shifts[iy, ix] = (dy - search, dx - search)
            valid[iy, ix] = True
    if not valid.any():
        return scan, extra
    # Fill empty tiles from neighbours, then median-smooth to reject bad estimates.
    med = np.median(shifts[valid], axis=0)
    shifts[~valid] = med
    shifts[..., 0] = ndimage.median_filter(shifts[..., 0], size=3, mode="nearest")
    shifts[..., 1] = ndimage.median_filter(shifts[..., 1], size=3, mode="nearest")
    if np.abs(shifts).max() < 1:
        return scan, extra
    # Smooth per-pixel displacement field from the tile grid.
    yy = (np.arange(h) + 0.5) / tile - 0.5
    xx = (np.arange(w) + 0.5) / tile - 0.5
    gy, gx = np.meshgrid(np.clip(yy, 0, ny - 1), np.clip(xx, 0, nx - 1), indexing="ij")
    dy = ndimage.map_coordinates(shifts[..., 0], [gy, gx], order=1)
    dx = ndimage.map_coordinates(shifts[..., 1], [gy, gx], order=1)
    ry, rx = np.mgrid[0:h, 0:w]
    warp = lambda a: ndimage.map_coordinates(a.astype(np.float32), [ry + dy, rx + dx], order=1, cval=255).astype(np.int16)
    return warp(scan), (warp(extra) if extra is not None else None)


def ink_mask(scan, tpl):
    """True where the scan has ink the blank template does not (handwriting, typing, ticks)."""
    tpl_dark = ndimage.grey_erosion(tpl, size=(7, 7))     # tolerate ~1px misalignment of printed lines
    # The template's light tint inside boxes/fields often scans as mid-gray or a copier dot
    # pattern. Measure what that tint became on THIS scan (per area of the page) and treat it as
    # blank paper; there, compare a smoothed scan so halftone dots blend into a flat gray.
    tint = (tpl_dark > 215) & (tpl_dark < 250)
    ref, eff = tpl_dark.astype(np.float32), scan.astype(np.float32)
    if tint.any():
        smooth = ndimage.gaussian_filter(eff, 2.0)
        level = _tint_level(smooth, tint)
        ref = np.where(tint, np.minimum(level, tpl_dark), ref)
        # Ink must be dark both raw and smoothed: halftone dots vanish when smoothed,
        # and blur from a thick printed border is not dark in the raw scan.
        eff = np.where(tint, np.maximum(smooth, eff), eff)
    margin = np.where(tint, np.minimum(INK_DIFF, 0.45 * ref), INK_DIFF)  # darker tint -> smaller margin
    mask = (ref - eff) > margin
    mask |= (eff < 110) & (ref > 200)                         # clearly dark ink over white paper
    return ndimage.binary_opening(mask, structure=np.ones((2, 2)))


def _tint_level(smooth, tint, tile=300):
    """Per-pixel brightness of the template tint as it came out on the scan (median per tile)."""
    h, w = smooth.shape
    ny, nx = (h + tile - 1) // tile, (w + tile - 1) // tile
    overall = float(np.median(smooth[tint]))
    grid = np.full((ny, nx), overall, np.float32)
    for iy in range(ny):
        for ix in range(nx):
            sl = (slice(iy * tile, (iy + 1) * tile), slice(ix * tile, (ix + 1) * tile))
            vals = smooth[sl][tint[sl]]
            if vals.size > 500:
                grid[iy, ix] = np.median(vals)
    return np.kron(grid, np.ones((tile, tile), np.float32))[:h, :w]


# ================================================================ OCR
_rapid_engine = None


def ocr(gray_img):
    """RapidOCR text recognition. Returns (text, mean confidence)."""
    global _rapid_engine
    if _rapid_engine is None:
        try:
            from rapidocr_onnxruntime import RapidOCR
        except ImportError:
            raise RuntimeError("OCR engine missing - run:  pip install -r requirements.txt") from None
        _rapid_engine = RapidOCR()
    img = np.clip(gray_img, 0, 255).astype(np.uint8)
    result, _ = _rapid_engine(np.ascontiguousarray(np.stack([img] * 3, axis=-1)))
    if not result:
        return "", 0.0
    # Words whose vertical spans overlap belong to the same line; read lines top-down, words left-right.
    words = sorted((min(p[1] for p in box), max(p[1] for p in box), min(p[0] for p in box), text, float(conf))
                   for box, text, conf in result)
    lines = []
    for w in words:
        mid = (w[0] + w[1]) / 2
        if lines and lines[-1][0] <= mid <= lines[-1][1]:
            lines[-1][2].append(w)
        else:
            lines.append([w[0], w[1], [w]])
    ordered = [w for _, _, ws in lines for w in sorted(ws, key=lambda w: w[2])]
    text = " ".join(w[3] for w in ordered).translate(HOMOGLYPHS)
    return text.strip(), sum(w[4] for w in ordered) / len(ordered)


def _px(rect, pad=(0, 0, 0, 0)):
    l, t, r, b = pad
    return (int((rect.y0 - t) * SCALE), int((rect.y1 + b) * SCALE),
            int((rect.x0 - l) * SCALE), int((rect.x1 + r) * SCALE))


def _crop(img, rect, pad):
    y0, y1, x0, x1 = _px(rect, pad)
    return img[max(y0, 0):y1, max(x0, 0):x1]


def mask_image(mask_crop):
    return np.pad(np.where(mask_crop, 0, 255).astype(np.uint8), 40, constant_values=255)


def tiled_char_ocr(mask_crop):
    """OCR ignores a lone glyph; repeat it a few times and take the majority letter."""
    ys, xs = np.nonzero(mask_crop)
    if len(ys) == 0:
        return "", 0.0
    g = np.where(mask_crop[max(ys.min() - 6, 0):ys.max() + 6, max(xs.min() - 6, 0):xs.max() + 6], 0, 255).astype(np.uint8)
    gap = np.full((g.shape[0], max(g.shape[1] // 2, 10)), 255, np.uint8)
    votes, confs = Counter(), []
    for k in (3, 4, 5):
        t, c = ocr(np.pad(np.hstack([x for _ in range(k) for x in (g, gap)]), 40, constant_values=255))
        for ch in re.sub(r"[^A-Za-z0-9]", "", t):
            votes[ch.upper()] += 1
        if t:
            confs.append(c)
    if not votes:
        return "", 0.0
    ch, n = votes.most_common(1)[0]
    return ch, (sum(confs) / len(confs)) * (n / sum(votes.values()))


# ================================================================ field cleanup / validation
def _digits(s):
    return re.sub(r"\D", "", s.translate(DIGIT_FIX))


def _fix_split_words(t):
    """Join OCR word fragments ("enrolm ent" -> "enrollment") using the system dictionary."""
    toks = t.split(" ")
    out = []
    i = 0
    while i < len(toks):
        a = toks[i]
        if i + 1 < len(toks) and a.isalpha() and toks[i + 1].isalpha():
            b = toks[i + 1]
            joined = (a + b).lower()
            a_ok, b_ok = a.lower() in WORDS, b.lower() in WORDS
            if not (a_ok and b_ok) or len(b) <= 2:
                dom = difflib.get_close_matches(joined, DOMAIN_WORDS, n=1, cutoff=0.8)
                if dom:
                    out.append(dom[0])
                    i += 2
                    continue
                if joined in WORDS:
                    out.append(a + b)
                    i += 2
                    continue
                close = difflib.get_close_matches(joined, [w for w in WORDS if w[:1] == joined[:1]
                                                           and abs(len(w) - len(joined)) <= 2], n=1, cutoff=0.85)
                if close and not (a_ok and b_ok):
                    out.append(close[0])
                    i += 2
                    continue
        out.append(a)
        i += 1
    return " ".join(out)


def clean_value(name, text):
    """Return (value, is_valid) for an OCR string."""
    t = re.sub(r"\s+", " ", text.translate(HOMOGLYPHS)).strip()
    if not t:
        return "", False
    if name == "owner_email":
        t = re.sub(r"\s+", "", t)
        t = re.sub(r"^[^A-Za-z0-9]+", "", t).rstrip(".,;:")
        t = t.replace(",", ".").lower()
        ok = bool(re.fullmatch(r"[\w.+'-]+@[\w-]+(\.[\w-]+)+", t))
        if "@" in t:
            local, domain = t.split("@", 1)
            close = difflib.get_close_matches(domain, EMAIL_DOMAINS, n=1, cutoff=0.8)
            if close and close[0] != domain:
                return f"{local}@{close[0]}", False                 # snapped to a known domain: still review it
        return t, ok
    if name == "owner_ssn":
        d = _digits(t)
        return (f"{d[:3]}-{d[3:5]}-{d[5:]}", True) if len(d) == 9 else (t, False)
    if name in ("owner_phone", "owner_fax"):
        d = _digits(t)
        if len(d) == 11 and d[0] == "1":
            d = d[1:]
        return (f"{d[:3]}-{d[3:6]}-{d[6:]}", True) if len(d) == 10 else (t, False)
    if name == "owner_date_of_birth":
        m = re.search(r"(\d{1,2})\s*[/\-.]\s*(\d{1,2})\s*[/\-.]\s*(\d{4}|\d{2})(?!\d)", t.translate(DIGIT_FIX))
        if m:
            mo, dy, yr = int(m.group(1)), int(m.group(2)), m.group(3)
            ok = 1 <= mo <= 12 and 1 <= dy <= 31 and len(yr) == 4 and 1900 <= int(yr) <= 2100
            return f"{mo:02d}/{dy:02d}/{yr}", ok
        # A "1" written right after "/" often merges into the slash ("04/12/1982" -> "04/2/982").
        m = re.search(r"(\d{1,2})\s*/\s*(\d{1,2})\s*/\s*(\d{3})\b", t.translate(DIGIT_FIX))
        if m and m.group(3)[0] in "89":
            mo, dy, yr = int(m.group(1)), m.group(2), "1" + m.group(3)
            if len(dy) == 1 and int("1" + dy) <= 31:
                dy = "1" + dy
            if 1 <= mo <= 12 and 1 <= int(dy) <= 31:
                return f"{mo:02d}/{int(dy):02d}/{yr}", False         # repaired guess: flag for review
        d = _digits(t)
        if len(d) == 8 and 1 <= int(d[:2]) <= 12 and 1 <= int(d[2:4]) <= 31:
            return f"{d[:2]}/{d[2:4]}/{d[4:]}", True
        return t, False
    if name == "member_capacity":
        d = _digits(t)
        return (str(int(d)), True) if d else (t, False)
    if name == "owner_middle_initial":
        letters = re.sub(r"[^A-Za-z]", "", t)
        return (letters[0].upper(), True) if letters else (t, False)
    if name == "owner_suffix":
        u = re.sub(r"[^A-Za-z/]", "", t).upper()
        if u in ("NA", "N/A", "NIA", "N1A", "WA", "MA"):
            return "N/A", True
        known = {"JR": "Jr.", "JI": "Jr.", "JT": "Jr.", "SR": "Sr.", "ST": "Sr.", "II": "II", "III": "III", "IV": "IV", "V": "V"}
        return (known[u], True) if u in known else (t, len(u) <= 4)
    if name in ("owner_first_name", "owner_last_name"):
        t = re.sub(r"[^A-Za-z' .-]", "", t).strip()
        return t, bool(re.fullmatch(r"[A-Za-z][A-Za-z' .-]*", t))
    # free text (update_explanation, other_ethnicity)
    t = re.sub(r"^N\s*[/I1l]?\s*A\b", "N/A", t)
    t = re.sub(r"\s*-\s*", " - ", t)
    return _fix_split_words(t), True


def read_text_field(name, rect, mask, scan):
    """OCR one field several ways; return (value, confidence, valid)."""
    inside = _crop(mask, rect, (0, 1, 0, 1))
    if inside.sum() < TEXT_MIN_PIXELS:
        return "", 1.0, True                               # blank field

    mcrop = _crop(mask, rect, (4, 7, 4, 4))                # handwriting often rises above the box
    gcrop = np.pad(_crop(scan, rect, (2, 1, 2, 2)), 40, constant_values=255)
    tries = []
    if name in SINGLE_CHAR_FIELDS:
        tries.append(tiled_char_ocr(mcrop))
    tries += [ocr(mask_image(mcrop)),
              ocr(gcrop)]
    if not any(t for t, _ in tries):
        tries.append(tiled_char_ocr(mcrop))

    scored = []
    for raw, conf in tries:
        if not raw:
            continue
        val, ok = clean_value(name, raw)
        scored.append((ok, conf, val))
    if not scored:
        return "", 0.0, False
    # Prefer answers that pass the format check, then agreement between independent passes,
    # then the longer reading (OCR's usual mistake is dropping a squeezed character), then confidence.
    agree = Counter(clean_value(name, r)[0] for r, _ in tries if r)
    scored.sort(key=lambda s: (s[0], agree[s[2]], len(s[2]), s[1]), reverse=True)
    ok, conf, val = scored[0]
    return val, conf, ok


# ================================================================ checkboxes
def detect_checkboxes(mask, boxes, text_rects, scan=None, tpl=None, colorless=None):
    """Return ({field_name: ink_score}, mask_without_ticks).
    Each ink stroke is credited to ONE box, chosen by the stroke's lowest point (the
    vertex of a tick): inside a box, or just above it, wins; strokes far from any box
    are ignored."""
    m = mask.copy()
    for r in text_rects:
        y0, y1, x0, x1 = _px(r)
        m[y0:y1, x0:x1] = False
    labels, n = ndimage.label(m, structure=np.ones((3, 3)))
    score = {name: 0 for name, _ in boxes}
    tick_mask = np.zeros_like(mask)
    if n == 0:
        return score, mask

    box_px = [(name, _px(r)) for name, r in boxes]
    search = CHECK_SEARCH_PT * SCALE
    max_span = 30 * SCALE                                  # bigger strokes are lines/scribbles, not ticks
    for idx, sl in enumerate(ndimage.find_objects(labels), start=1):
        comp = labels[sl] == idx
        npx = int(comp.sum())
        if npx < 15:
            continue
        if (sl[0].stop - sl[0].start) > max_span or (sl[1].stop - sl[1].start) > max_span:
            continue
        ys, xs = np.nonzero(comp)
        ys = ys + sl[0].start
        xs = xs + sl[1].start
        bottom = ys.max()
        px = int(xs[ys >= bottom - 2].mean())
        py = int(bottom)
        best, best_cost = None, None
        for name, (y0, y1, x0, x1) in box_px:
            dx = max(x0 - px, 0, px - x1)
            if py < y0:
                dy = y0 - py                               # vertex above box: typical offset tick
            elif py > y1:
                dy = (py - y1) * 3                         # below box: much less likely
            else:
                dy = 0
            cost = (dx * 1.5) + dy
            if cost <= search and (best_cost is None or cost < best_cost):
                best, best_cost = name, cost
        if best is not None:
            score[best] += npx
            tick_mask[sl] |= comp

    # Filled-in / shaded / scribbled boxes: if the box interior is mostly ink, it is checked
    # no matter what the strokes look like (covers solid fills that bleed into neighbours).
    for name, (y0, y1, x0, x1) in box_px:
        inset = int(1.2 * SCALE)
        interior = mask[y0 + inset:y1 - inset, x0 + inset:x1 - inset]
        if interior.size and interior.mean() >= FILL_RATIO:
            score[name] = max(score[name], CHECK_MIN_PIXELS * 10)
            tick_mask[y0:y1, x0:x1] = True

    # Light fills (pale gray / colored shading too light to count as ink): the box interior is
    # evenly darker than the template's, compared with how the other boxes on the page came out.
    if scan is not None and tpl is not None:
        inset = int(1.2 * SCALE)
        diffs = {name: (tpl[y0 + inset:y1 - inset, x0 + inset:x1 - inset].astype(np.int16)
                        - scan[y0 + inset:y1 - inset, x0 + inset:x1 - inset])
                 for name, (y0, y1, x0, x1) in box_px}
        typical = float(np.median([np.median(d) for d in diffs.values() if d.size]))
        if colorless is not None:                          # pale yellow etc.: same gray, but colored
            sats = {name: 255 - colorless[y0 + inset:y1 - inset, x0 + inset:x1 - inset]
                    for name, (y0, y1, x0, x1) in box_px}
            typical_sat = float(np.median([np.median(v) for v in sats.values() if v.size]))
        for name, d in diffs.items():
            tinted = (d - typical) >= 18
            if colorless is not None:
                tinted = tinted | ((sats[name] - typical_sat) >= 30)
            if d.size and tinted.mean() >= CHECK_SHADED_ON:
                score[name] = max(score[name], CHECK_MIN_PIXELS * 10)
    return score, mask & ~tick_mask


# ================================================================ main conversion
def pick_page(doc, tpl_img):
    """For multi-page scans, use the page that best matches the template."""
    if len(doc) == 1:
        return 0
    step = 8
    tb = _ink(tpl_img[::step, ::step])
    best = (-1, 0)
    for i, page in enumerate(doc):
        img = render_gray(page, dpi=DPI // step)
        for k in range(4):
            s = _xcorr(_ink(fit_shape(np.rot90(img, k), tb.shape)), tb)[0]
            best = max(best, (s, i))
    return best[1]


# ================================================================ other form layouts
# A scan whose layout is not the template's (another plan's county/services form, etc.) is read
# by its printed labels instead of by position: OCR the whole page, take the text after labels
# like "Agency Name:" / "NPI:", and pair every checkbox with the county/service name beside it.
LAYOUT_MATCH_MIN = 0.6    # template match below this => different form, read it by labels
DYN_DPI = 300
CHECK_CONTRAST_ON = 0.36  # box middle this much darker than the paper beside it (1 = as dark as the outline) ...
CHECK_DARK_ON = 0.28      # ... and this share of it truly ink-dark => checked (tick or filled square)
CHECK_SHADED_ON = 0.85    # or this share of it evenly tinted / colored => checked (light-colored fill)

# label printed on the scan -> what it is
SCAN_LABELS = {
    "entity": ["agency name", "provider agency name", "entity name", "provider name", "organization name",
               "legal name", "business name", "group name"],
    "npi": ["npi", "npi number", "group npi", "billing npi", "type 2 npi"],
    "tin": ["tin", "tax id", "ein", "federal tax id", "tax id number"],
    "contact_name": ["contact name", "contact person"],
    "contact_email": ["contact email", "contact e mail"],
    "email": ["email", "e mail", "email address"],
    "contact_phone": ["contact phone", "contact phone number"],
    "phone": ["phone", "telephone", "phone number"],
    "fax": ["fax", "fax number"],
    "address": ["address", "service address", "street address"],
    "caqh": ["caqh id", "caqh"],
}
# what it is -> template text field, found by these words in the field's name / tooltip
# (so a template with fields like "Entity Name" or "NPI" is picked up automatically)
TEMPLATE_KEYS = {
    "entity": [r"\bentity\b", r"\bagency name\b", r"\bprovider name\b", r"\borganization\b"],
    "npi": [r"\bnpi\b"],
    "tin": [r"\btin\b", r"\btax\b", r"\bein\b"],
    "email": [r"\be ?mail\b"],
    "phone": [r"\bphone\b", r"\btelephone\b"],
    "fax": [r"\bfax\b"],
    "address": [r"\baddress\b"],
    "caqh": [r"\bcaqh\b"],
    "first_name": [r"\bfirst name\b", r"\bfirst\b"],
    "last_name": [r"\blast name\b", r"\blast\b"],
}
STRICT_KINDS = {"npi", "tin", "phone", "contact_phone", "fax", "email", "contact_email"}  # re-read enlarged
LETTER_FIX = str.maketrans({"0": "o", "1": "i", "5": "s", "8": "b", "9": "g", "|": "l"})


def _words(t):
    return re.sub(r"[^a-z0-9]+", " ", t.lower().replace("_", " ")).strip()


def _ratio(a, b):
    return difflib.SequenceMatcher(None, a, b).ratio()


def _field_text(w):
    return _words(f"{w.field_name} {w.field_label or ''}")


def template_field(text_widgets, kind):
    for w in text_widgets:
        if any(re.search(p, _field_text(w)) for p in TEMPLATE_KEYS.get(kind, [])):
            return w.field_name
    return None


def checkbox_names(w):
    """Ways a template checkbox may be printed on a scan ('Adams County' -> 'adams county', 'adams')."""
    out = set()
    for t in (w.field_name, w.field_label or ""):
        t = _words(re.sub(r"^(ethnicity|gender)_", "", t))
        t = re.sub(r"\(.*", "", t).strip()
        if t:
            out |= {t, re.sub(r" county$", "", t)}
    return out


def parse_label(text, with_score=False):
    """'Agency Name:Acme Care' -> ('entity', 'Acme Care'); 'NPI1234567890' -> ('npi', '1234567890')."""
    best = (0.0, None, "")
    head, sep, val = text.partition(":")
    head_w = _words(head)
    letters = re.sub(r"[^A-Za-z]", "", text).lower()
    for kind, labels in SCAN_LABELS.items():
        for lab in labels:
            if sep:
                r = _ratio(head_w, lab)
                if len(lab) <= 4 and len(head_w) >= 2 and lab.startswith(head_w):
                    r = max(r, 0.85)                         # clipped short label: "NP:" for "NPI:"
                if r > best[0]:
                    best = (r, kind, val)
            # colon lost: label glued to its value ("NPI1234567890", "Contac Emai x@y.com")
            squeezed_lab = lab.replace(" ", "")
            n = len(squeezed_lab)
            for k in range(max(2, n - 2), min(len(letters), n + 2) + 1):
                r = _ratio(letters[:k], squeezed_lab) - 0.02
                if r <= best[0]:
                    continue
                m = re.match(r"(?:[^A-Za-z]*[A-Za-z]){%d}" % k, text)
                rest = text[m.end():] if m else ""
                # "Email completed form to ..." is a sentence, not a label: a one-word label
                # must be glued to its value or be followed by a number
                if " " in lab or (rest and not rest[0].isspace()) or rest.strip()[:1].isdigit():
                    best = (r, kind, rest.lstrip(" :.-"))
    kind, value = (best[1], best[2].strip()) if best[0] >= 0.82 else (None, "")
    return (kind, value, best[0]) if with_score else (kind, value)


def _rgb_u8(page, dpi):
    pix = page.get_pixmap(dpi=dpi, colorspace=pymupdf.csRGB, alpha=False)
    return np.frombuffer(pix.samples, np.uint8).reshape(pix.height, pix.width, 3).copy()


def _gray_of(rgb):
    return np.clip(rgb @ np.array([0.299, 0.587, 0.114]), 0, 255).astype(np.uint8)


def _gray_u8(page, dpi):
    return _gray_of(_rgb_u8(page, dpi))


def ocr_items(img):
    """Whole-page OCR -> list of (x0, y0, x1, y1, text, conf)."""
    ocr(np.full((8, 8), 255))                              # make sure the engine is loaded
    result, _ = _rapid_engine(np.ascontiguousarray(np.stack([img] * 3, axis=-1)))
    items = []
    for box, text, conf in result or []:
        b = np.asarray(box)
        items.append((*b.min(0), *b.max(0), text.translate(HOMOGLYPHS).strip(), float(conf)))
    return [(int(i[0]), int(i[1]), int(i[2]), int(i[3]), i[4], i[5]) for i in items if i[4]]


def find_squares(img, size):
    """Checkbox-like squares about `size` px tall (outer box kept when boxes are nested)."""
    import cv2
    block = max(15, int(size) | 1)
    th = cv2.adaptiveThreshold(img, 255, cv2.ADAPTIVE_THRESH_MEAN_C, cv2.THRESH_BINARY_INV, block, 15)
    contours, _ = cv2.findContours(th, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
    found = []
    for c in contours:
        x, y, w, h = cv2.boundingRect(c)
        if 0.4 * size <= w <= 1.6 * size and 0.4 * size <= h <= 1.6 * size and 0.7 <= w / h <= 1.4 \
                and cv2.contourArea(cv2.convexHull(c)) >= 0.75 * w * h:
            found.append((x, y, w, h))
    found.sort(key=lambda b: -b[2] * b[3])
    keep = []
    for x, y, w, h in found:
        cx, cy = x + w / 2, y + h / 2
        if not any(k[0] <= cx <= k[0] + k[2] and k[1] <= cy <= k[1] + k[3] for k in keep):
            keep.append((x, y, w, h))
    return keep


def box_center_ink(img, x, y, w, h, rgb=None):
    """(contrast, dark share, shaded share) of the box's middle against the paper just outside the box.
    Only the middle is measured, so double ("box inside box") borders don't count; the paper
    is measured right next to the box, so gray scans, glare and screen moire cancel out.
    Shaded share = how much of the middle is tinted/colored at all (a light gray or yellow fill).
    Empty ~ (0, 0, 0); tick ~ (0.4, 0.3, 0.4); filled square ~ (1+, 1, 1); light fill ~ (0.1+, 0, 1)."""
    i = int(round(min(w, h) * 0.3))
    center = img[y + i:y + h - i, x + i:x + w - i].astype(np.float32)
    if center.size == 0:
        return 0.0, 0.0, 0.0
    g, G = int(w * 0.15), int(w * 0.5)
    y0, x0 = max(0, y - G), max(0, x - G)
    big = img[y0:y + h + G, x0:x + w + G].astype(np.float32)
    outside = np.ones(big.shape, bool)
    outside[max(0, y - y0 - g):y - y0 + h + g, max(0, x - x0 - g):x - x0 + w + g] = False
    paper = float(np.median(big[outside])) if outside.any() else 255.0
    frame = np.concatenate([img[y:y + h, x:x + 2].ravel(), img[y:y + h, x + w - 2:x + w].ravel(),
                            img[y:y + 2, x:x + w].ravel(), img[y + h - 2:y + h, x:x + w].ravel()])
    ink = min(float(np.percentile(frame, 20)), paper - 60)  # box outline darkness = what "ink" looks like
    contrast = float(np.clip((paper - center.mean()) / (paper - ink), 0, 1.5))
    dark = float((center < ink + 0.35 * (paper - ink)).mean())
    tinted = (paper - center) >= max(15.0, 0.08 * (paper - ink))
    if rgb is not None:                                      # colored fill (yellow/blue/...) even if light
        sat = lambda a: a.max(-1).astype(np.int16) - a.min(-1)
        paper_sat = float(np.median(sat(rgb[y0:y + h + G, x0:x + w + G])[outside])) if outside.any() else 0.0
        tinted |= sat(rgb[y + i:y + h - i, x + i:x + w - i]) >= paper_sat + 30
    return contrast, dark, float(tinted.mean())


def box_state(contrast, dark, shaded=0.0, fills_count=True):
    """'on', 'faint' (unchecked, needs review), 'light' (checked, filled with a light shade/color) or 'off'.
    fills_count=False when most boxes on the page are tinted (printed background, not a fill)."""
    if contrast >= CHECK_CONTRAST_ON and dark >= CHECK_DARK_ON:
        return "light" if contrast >= 0.8 and dark < 0.8 else "on"
    if fills_count and shaded >= CHECK_SHADED_ON:
        return "light"
    if contrast >= CHECK_CONTRAST_ON * 0.7 or dark >= CHECK_DARK_ON * 0.7:
        return "faint"
    return "off"


def extract_by_labels(page):
    """Read a scan that is a different form from the template. Returns (values, checks, info, review)."""
    tpl_page = pymupdf.open(TEMPLATE)[0]
    widgets = list(tpl_page.widgets())
    text_w = [w for w in widgets if w.field_type == pymupdf.PDF_WIDGET_TYPE_TEXT]
    box_w = [w for w in widgets if w.field_type == pymupdf.PDF_WIDGET_TYPE_CHECKBOX]
    review = ["different form layout from the template - read by labels; please compare with the scan"]

    rgb = _rgb_u8(page, DYN_DPI)
    img = _gray_of(rgb)
    items = ocr_items(img)
    for k in (2, 1, 3):                                     # page upside down / sideways?
        if sum(parse_label(t)[0] is not None for *_, t, _ in items) >= 2 or len(items) > 40:
            break
        rot = np.ascontiguousarray(np.rot90(img, k))
        rot_items = ocr_items(rot)
        if len(rot_items) > len(items):
            img, items, rgb = rot, rot_items, np.ascontiguousarray(np.rot90(rgb, k))
    if not items:
        raise ValueError("no text found on the scan")
    size = float(np.median([y1 - y0 for x0, y0, x1, y1, t, c in items]))

    # ---- labelled text values ("Agency Name: ...", "NPI: ...")
    found = {}
    lines = sorted(items, key=lambda i: (i[1] + i[3]) / 2)
    for idx, (x0, y0, x1, y1, text, conf) in enumerate(lines):
        kind, value, score = parse_label(text, with_score=True)
        if not kind or score <= found.get(kind, (0, None))[0]:
            continue                                       # keep the best-matching label ("Agency Name:" beats a heading)
        cy, h = (y0 + y1) / 2, y1 - y0
        right = x1
        # value may continue in separate OCR boxes to the right on the same line
        for (a0, b0, a1, b1, t2, c2) in sorted(lines, key=lambda i: i[0]):
            if a0 > right - 2 and abs((b0 + b1) / 2 - cy) < 0.5 * h and a0 - right < 2.5 * h:
                if parse_label(t2)[0]:
                    break
                value, right, conf = f"{value} {t2}".strip(), a1, min(conf, c2)
        cands = [(value.strip(), conf)]
        # second read of just the value, enlarged 2x (small print like emails / NPI reads better)
        pos = text.find(value[:3]) if value[:3] and value[:3] in text else 0   # where the value starts
        start = int(x0 + (x1 - x0) * pos / max(len(text), 1))
        crop = img[max(0, int(y0)):int(y1), max(0, start - 4):int(right + 4)]
        if crop.size and kind in STRICT_KINDS:
            t2, c2 = ocr(np.pad(ndimage.zoom(crop, 2, order=1), 30, constant_values=255))
            k2, v2 = parse_label(t2)
            cands.append(((v2 if k2 == kind else t2).strip(), c2))
        found[kind] = (score, cands)

    values = {}

    def put(kind, cands, check=None):
        name = template_field(text_w, kind)
        scored = []
        for value, conf in cands:
            if value:
                value, ok = check(value) if check else (value, True)
                scored.append((ok, conf, value))
        if not scored:
            return
        ok, conf, value = max(scored)
        if not name:
            review.append(f"'{kind}' on scan ({value}) - no matching field in the template")
            return
        values[name] = value
        if not ok or conf < 0.5:
            review.append(f"{name}: '{value}' (confidence {conf:.2f}{'' if ok else ', format check failed'})")

    def digits_of(n):
        return lambda v: (_digits(v), len(_digits(v)) == n)

    for kind, (_, cands) in found.items():
        if kind == "npi":
            put("npi", cands, digits_of(10))
        elif kind == "tin":
            put("tin", cands, digits_of(9))
        elif kind == "entity":
            put("entity", cands, lambda v: (re.sub(r"\s+", " ", v), len(v) >= 2))
        elif kind in ("phone", "fax") and not (kind == "phone" and "contact_phone" in found):
            put(kind, cands, lambda v, k=kind: clean_value(f"owner_{k}", v))
        elif kind == "contact_phone":
            put("phone", cands, lambda v: clean_value("owner_phone", v))
        elif kind in ("email", "contact_email") and not (kind == "email" and "contact_email" in found):
            put("email", cands, lambda v: clean_value("owner_email", v))
        elif kind in ("address", "caqh"):
            put(kind, cands)
        elif kind == "contact_name":
            value = max(cands, key=lambda c: c[1])[0]
            name = re.sub(r"[^A-Za-z' .-]", " ", value).split()
            first_f, last_f = template_field(text_w, "first_name"), template_field(text_w, "last_name")
            if name and first_f:
                # contact name -> (owner) first name = first word, last name = the rest
                values[first_f] = name[0]
                if last_f:
                    values[last_f] = " ".join(name[1:])
                review.append(f"contact name '{' '.join(name)}' split into first '{name[0]}' / last '{' '.join(name[1:])}'")
            elif name:
                review.append(f"contact name '{' '.join(name)}' - template has no First Name field")

    # ---- checkboxes: match printed names to template checkboxes, then look left for the box
    def inside_word(x, y, w, h):
        """Square lies within an OCR'd word, past its first character => it's a letter (o, D, N...)."""
        cx, cy = x + w / 2, y + h / 2
        return any(i0 + 0.6 * (i3 - i1) < cx < i2 and i1 < cy < i3 for i0, i1, i2, i3, *_ in items)

    squares = [s for s in find_squares(img, size) if not inside_word(*s)]
    names = {w.field_name: checkbox_names(w) for w in box_w}

    def label_score(text, field):
        t = _words(text.translate(LETTER_FIX))
        best = 0.0
        for v in names[field]:
            if not (0.45 * len(v) <= len(t) <= 1.6 * len(v) + 2):
                continue
            r = max(_ratio(t, v), _ratio(t[1:], v) if len(t) > 4 else 0)            # stray box glyph in front
            if len(t) >= 12 and len(t) < len(v):
                r = max(r, _ratio(t, v[:len(t)]) - 0.05)                           # name cut off at the end
            if len(v) <= 5 and r < 0.85:
                r = 0.0                                    # short names ("Jay", "Male") need a close match
            best = max(best, r)
        return best

    def box_left_of(x0, y0, x1, y1):
        h, cy = y1 - y0, (y0 + y1) / 2
        cands = [s for s in squares if abs(s[1] + s[3] / 2 - cy) < 0.6 * h
                 and x0 - 2.2 * h <= s[0] + s[2] / 2 <= x0 + 0.8 * h]
        if not cands:
            return None
        # a square left of where the word starts is the checkbox; one inside the word is a letter
        # (N, o, D...) unless OCR swallowed the box into the word ("□Daviess")
        left = [s for s in cands if s[0] + s[2] / 2 <= x0]
        cands = left or cands
        # drop small squares (letters), then take the one on the label's line
        big = max(s[2] * s[3] for s in cands)
        cands = [s for s in cands if s[2] * s[3] >= 0.6 * big]
        return min(cands, key=lambda s: abs(s[1] + s[3] / 2 - cy) + 0.3 * abs(s[0] + s[2] - x0))

    pairs = sorted(((label_score(it[4], f), i, f) for i, it in enumerate(items) for f in names), reverse=True)
    used_items, matched = set(), {}
    for score, i, f in pairs:
        if score < 0.72:
            break
        if i in used_items or f in matched:
            continue
        box = box_left_of(*items[i][:4])
        if box is None:
            continue
        used_items.add(i)
        matched[f] = box

    # second pass: boxes that have no name yet -> OCR just the text to their right
    used_boxes = set(matched.values())
    box_h = np.median([b[3] for b in used_boxes]) if used_boxes else size
    for (x, y, w, h) in squares:
        if (x, y, w, h) in used_boxes or not 0.75 * box_h <= h <= 1.3 * box_h:
            continue
        if any(i0 + 1.5 * (i3 - i1) < x + w / 2 < i2 and i1 < y + h / 2 < i3 for i0, i1, i2, i3, *_ in items):
            continue                                       # a letter inside a word, not a checkbox
        crop = img[max(0, y - h // 3):y + h + h // 3, x + w:x + w + int(13 * h)]
        text, conf = ocr(np.pad(crop, 20, constant_values=255))
        text = re.split(r"\s{2,}|\s+[^A-Za-z\s]{1,2}\s", text)[0]          # stop at the next column
        cands = sorted(((label_score(text, f), f) for f in names if f not in matched), reverse=True)
        if cands and cands[0][0] >= 0.72:
            matched[cands[0][1]] = (x, y, w, h)
        elif len(re.sub(r"[^A-Za-z]", "", text)) >= 3 and box_state(*box_center_ink(img, x, y, w, h)) == "on":
            review.append(f"checked box '{text.strip()}' on scan has no matching checkbox in the template")

    checks = {f: False for f in names}
    measured = {f: box_center_ink(img, *b, rgb=rgb) for f, b in matched.items()}
    # if most boxes are tinted, the tint is the form's printed background, not someone's fill
    tinted_boxes = sum(m[2] >= CHECK_SHADED_ON for m in measured.values())
    fills_count = tinted_boxes <= 0.4 * max(len(measured), 1)
    for f, m in measured.items():
        state = box_state(*m, fills_count=fills_count)
        checks[f] = state in ("on", "light")
        if state == "faint":
            review.append(f"checkbox '{f}': light/partial mark, left unchecked")
        elif state == "light":
            review.append(f"checkbox '{f}': filled with a light shade/color - counted as checked")

    # report template boxes not found on the scan, for sections the scan does have
    def group(f):
        return "counties" if f.endswith("County") else f.split("_")[0] if "_" in f else "services"
    for g in sorted({group(f) for f in names}):
        members = [f for f in names if group(f) == g]
        missing = [f for f in members if f not in matched]
        if missing and len(missing) <= len(members) / 2:
            review.append(f"{g}: could not find on scan (left unchecked): {', '.join(missing)}")

    info = {"layout": "by labels", "page": 1, "boxes_matched": len(matched), "labels": len(found)}
    return values, checks, info, review


def extract(scan_path):
    tpl_doc = pymupdf.open(TEMPLATE)
    tpl_page = tpl_doc[0]
    tpl_img = render_gray(tpl_page, annots=True)      # blank boxes + field shading included

    scan_doc = pymupdf.open(scan_path)
    if scan_doc.needs_pass:
        raise ValueError("PDF is password protected")
    page_no = pick_page(scan_doc, tpl_img)
    rgb = _rgb_u8(scan_doc[page_no], DPI)
    raw = normalize_paper(_gray_of(rgb).astype(np.int16))
    colorless = 255 - (rgb.max(-1).astype(np.int16) - rgb.min(-1))   # 255 = no color, lower = colored
    del rgb
    scan, info = align(raw, tpl_img, extra=colorless)
    colorless = info.pop("extra")
    if info["match"] < LAYOUT_MATCH_MIN:
        values, checks, dyn_info, review = extract_by_labels(scan_doc[page_no])
        dyn_info.update(page=page_no + 1, match=info["match"])
        return values, checks, dyn_info, review
    info["page"] = page_no + 1
    mask = ink_mask(scan, tpl_img)

    widgets = list(tpl_page.widgets())
    text_fields = [(w.field_name, w.rect) for w in widgets if w.field_type == pymupdf.PDF_WIDGET_TYPE_TEXT]
    boxes = [(w.field_name, w.rect) for w in widgets if w.field_type == pymupdf.PDF_WIDGET_TYPE_CHECKBOX]

    review = []
    if info["match"] < 0.25:
        review.append(f"scan matches the template poorly (score {info['match']}) - is this the right form?")

    scores, text_mask = detect_checkboxes(mask, boxes, [r for _, r in text_fields], scan, tpl_img, colorless)
    checks = {k: v >= CHECK_MIN_PIXELS for k, v in scores.items()}
    for k, v in scores.items():
        if CHECK_MIN_PIXELS * 0.5 <= v < CHECK_MIN_PIXELS:
            review.append(f"checkbox '{k}': faint mark, left unchecked")
    for a, b in EXCLUSIVE_PAIRS:
        if checks.get(a) and checks.get(b):
            loser = a if scores[a] < scores[b] else b
            checks[loser] = False
            review.append(f"both '{a}' and '{b}' marked; kept the stronger one")

    values = {}
    for name, rect in text_fields:
        val, conf, ok = read_text_field(name, rect, text_mask, scan)
        values[name] = val
        if val and (not ok or conf < 0.5):
            review.append(f"{name}: '{val}' (confidence {conf:.2f}{'' if ok else ', format check failed'})")
        elif not val and _crop(text_mask, rect, (0, 1, 0, 1)).sum() >= TEXT_MIN_PIXELS:
            review.append(f"{name}: has writing but could not be read")

    # Scans with a single "Contact Name" box: first word -> first name, the rest -> last name.
    # A lone letter after the first word is a middle initial (or an OCR stray if MI is already filled).
    words = values.get("owner_first_name", "").split()
    if len(words) >= 2 and not values.get("owner_last_name"):
        full = " ".join(words)
        rest = words[1:]
        if len(rest) >= 2 and len(rest[0].rstrip(".")) == 1:
            if not values.get("owner_middle_initial"):
                values["owner_middle_initial"] = rest[0][0].upper()
            rest = rest[1:]
        values["owner_first_name"], values["owner_last_name"] = words[0], " ".join(rest)
        review.append(f"contact name '{full}' split into first '{words[0]}' / last '{' '.join(rest)}'")

    # Cross-check: email local part usually spells the owner's name.
    email, first, last = values.get("owner_email", ""), values.get("owner_first_name", ""), values.get("owner_last_name", "")
    if "@" in email and first and last:
        local, domain = email.split("@", 1)
        guesses = {g.lower() for g in (f"{first}.{last}", f"{first}{last}", f"{first[0]}{last}", f"{first}_{last}")}
        if local not in guesses:
            ratio, guess = max((difflib.SequenceMatcher(None, local, g).ratio(), g) for g in guesses)
            if ratio >= 0.85 and abs(len(local) - len(guess)) <= 2:
                values["owner_email"] = f"{guess}@{domain}"
                review.append(f"owner_email: corrected '{email}' -> '{guess}@{domain}' to match owner name")

    if values.get("update_explanation") and not checks.get("update_enrollment") and not checks.get("new_enrollment"):
        review.append("neither New nor Update enrollment is checked")
    return values, checks, info, review


def fill_template(values, checks, out_path):
    doc = pymupdf.open(TEMPLATE)
    for page in doc:
        for w in page.widgets():
            if w.field_type == pymupdf.PDF_WIDGET_TYPE_TEXT and w.field_name in values:
                text = values[w.field_name]
                w.field_value = text
                # shrink the font so long values (agency names, addresses) fit instead of being cut off
                size = w.text_fontsize or 9
                width = pymupdf.get_text_length(text, fontname="helv", fontsize=size)
                if width > w.rect.width - 4:
                    w.text_fontsize = max(5.0, size * (w.rect.width - 4) / width)
                w.update()
            elif w.field_type == pymupdf.PDF_WIDGET_TYPE_CHECKBOX and w.field_name in checks:
                # Set the state directly so the template's own drawn check mark is shown
                # (w.update() would redraw it with a ZapfDingbats font some viewers don't render).
                state = "/" + (w.on_state() if checks[w.field_name] else "Off")
                doc.xref_set_key(w.xref, "V", state)
                doc.xref_set_key(w.xref, "AS", state)
    # Saved as a normal AcroForm: every field stays editable.
    doc.save(out_path, garbage=3, deflate=True)


def output_path_for(scan_path):
    stem = os.path.splitext(os.path.basename(scan_path))[0]
    return os.path.join(EXPORT_DIR, f"{stem}_converted.pdf")


def convert(scan_path, log=print):
    scan_path = os.path.normpath(scan_path)
    if not os.path.isfile(TEMPLATE):
        raise FileNotFoundError(f"Template not found: {TEMPLATE}\n"
                                f"Copy the 'Template' folder (with Template_Form.pdf) next to scan_to_form.py")
    if not os.path.isfile(scan_path):
        raise FileNotFoundError(f"Scan not found: {scan_path}")
    os.makedirs(EXPORT_DIR, exist_ok=True)
    log(f"Reading {os.path.basename(scan_path)} ...")
    values, checks, info, review = extract(scan_path)
    out = output_path_for(scan_path)
    fill_template(values, checks, out)
    if info.get("layout") == "by labels":
        log(f"  page {info['page']}: different form from the template (match {info['match']}) - read by labels, "
            f"{info['labels']} labelled values, {info['boxes_matched']} checkboxes located")
    else:
        log(f"  page {info['page']}, rotation {info['rotation90']}°, scale {info['scale']}, skew {info['skew_deg']}°, "
            f"shift {info['shift_px']}px, template match {info['match']}")
    for k, v in values.items():
        if v:
            log(f"  {k}: {v}")
    log("  checked: " + (", ".join(k for k, v in checks.items() if v) or "(none)"))
    if review:
        log("  REVIEW:")
        for r in review:
            log(f"    - {r}")
    log(f"Saved -> {out}")
    return out, review


# ================================================================ GUI
def find_adobe():
    """Path to Adobe Acrobat / Acrobat Reader on Windows, or None (then the default viewer, often a browser, is used)."""
    if sys.platform != "win32":
        return None
    import glob
    import winreg
    for exe in ("Acrobat.exe", "AcroRd32.exe"):                # Acrobat (Pro/Reader DC) first, then old Reader
        for hive in (winreg.HKEY_LOCAL_MACHINE, winreg.HKEY_CURRENT_USER):
            try:
                with winreg.OpenKey(hive, rf"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\{exe}") as k:
                    path = winreg.QueryValue(k, None).strip('"')
                if os.path.isfile(path):
                    return path
            except OSError:
                pass
    for pattern in (r"C:\Program Files\Adobe\*\Acrobat\Acrobat.exe",
                    r"C:\Program Files (x86)\Adobe\*\Acrobat\Acrobat.exe",
                    r"C:\Program Files (x86)\Adobe\*\Reader\AcroRd32.exe"):
        hits = glob.glob(pattern)
        if hits:
            return hits[0]
    return None


def run_gui():
    import ctypes
    import subprocess
    import tkinter as tk
    from tkinter import filedialog, messagebox, scrolledtext

    try:
        ctypes.windll.shcore.SetProcessDpiAwareness(1)        # crisp text on high-DPI Windows screens
    except (AttributeError, OSError):
        pass
    root = tk.Tk()
    root.title("Scan to Form Converter")
    root.geometry("760x520")

    frm = tk.Frame(root, padx=12, pady=12)
    frm.pack(fill="both", expand=True)
    tk.Label(frm, text="1) Click Select PDF and pick a scanned form.   2) Click Generate.\nThe editable, filled form is saved to the Export folder as <name>_converted.pdf",
             anchor="w").pack(fill="x")
    sel_var = tk.StringVar(value="No file selected")
    tk.Label(frm, textvariable=sel_var, anchor="w", fg="#555", wraplength=720, justify="left").pack(fill="x", pady=(4, 8))

    btns = tk.Frame(frm)
    btns.pack(fill="x")
    log_box = scrolledtext.ScrolledText(frm, height=22, font=("Consolas", 10))
    log_box.pack(fill="both", expand=True, pady=(10, 0))

    selected = []

    def log(msg):
        log_box.insert("end", msg + "\n")
        log_box.see("end")
        root.update()

    adobe = find_adobe()

    def open_path(path):
        # PDFs open in Adobe when installed (so the converted form can be edited); otherwise the
        # default viewer / browser. Folders open in File Explorer. Elsewhere (testing only): macOS "open".
        try:
            if adobe and path.lower().endswith(".pdf"):
                subprocess.Popen([adobe, path])
            elif hasattr(os, "startfile"):
                os.startfile(path)
            else:
                subprocess.run(["open", path], check=True)
        except Exception as e:
            log(f"Could not open {path}: {e}")

    def choose():
        # Windows ignores initialdir once it has been used before and jumps to the last-used folder;
        # a full path in the file-name box overrides that, so the picker always opens in the script folder.
        start = {"initialfile": os.path.join(BASE_DIR, "*.*")} if sys.platform == "win32" else {}
        paths = filedialog.askopenfilenames(title="Select scanned PDF", initialdir=BASE_DIR, **start,
                                            filetypes=[("All files", "*.*"),
                                                       ("PDF / image scans", "*.pdf *.png *.jpg *.jpeg *.tif *.tiff")])
        # Windows Tk can hand back one "{C:/a b.pdf} {C:/c.pdf}" string instead of a tuple.
        paths = [os.path.normpath(p) for p in root.tk.splitlist(paths)] if paths else []
        if paths:
            selected[:] = paths
            sel_var.set("; ".join(os.path.basename(p) for p in paths))
            convert_btn.config(state="normal")

    def do_convert():
        convert_btn.config(state="disabled")
        outputs, flagged = [], 0                            # outputs: (scan, converted) pairs
        for p in selected:
            try:
                out, review = convert(p, log)
                outputs.append((p, out))
                flagged += bool(review)
            except Exception as e:
                log(f"ERROR on {p}: {e}")
            log("")
        convert_btn.config(state="normal")
        if outputs:
            msg = f"{len(outputs)} file(s) saved to Export."
            if flagged:
                msg += f"\n{flagged} file(s) have items to REVIEW (see log)."
            viewer = "Adobe" if adobe else "your default PDF viewer"
            if messagebox.askyesno("Done", msg + f"\n\nOpen the scanned file and the converted file in {viewer} to compare?"):
                for scan, out in outputs:
                    open_path(scan)
                    open_path(out)

    tk.Button(btns, text="Select PDF...", command=choose).pack(side="left")
    convert_btn = tk.Button(btns, text="Generate", command=do_convert, state="disabled")
    convert_btn.pack(side="left", padx=8)
    tk.Button(btns, text="Open Export Folder",
              command=lambda: (os.makedirs(EXPORT_DIR, exist_ok=True), open_path(EXPORT_DIR))
              ).pack(side="right")

    root.mainloop()


if __name__ == "__main__":
    if sys.stdout is not None:
        sys.stdout.reconfigure(errors="replace")             # Windows console code pages can't print every character
    if len(sys.argv) > 1:
        for p in sys.argv[1:]:
            convert(p)
    else:
        run_gui()
