
from reportlab.pdfgen import canvas
from pypdf import PdfReader, PdfWriter
from io import BytesIO

reader = PdfReader("original.pdf")
page = reader.pages[0]

width = float(page.mediabox.width)
height = float(page.mediabox.height)

buffer = BytesIO()
c = canvas.Canvas(buffer, pagesize=(width, height))

# Adjust coordinates to position the row
x = 40
y = height - 330
row_width = width - 80
row_height = 30
half = row_width / 2

# Draw row and two columns
c.rect(x, y, row_width, row_height)
c.line(x + half, y, x + half, y + row_height)

# Add editable text fields
c.acroForm.textfield(
    name="N",
    tooltip="N",
    x=x + 40,
    y=y + 5,
    width=half - 45,
    height=20,
    borderWidth=0,
    forceBorder=False
)

c.acroForm.textfield(
    name="",
    tooltip="",
    x=x + half + 90,
    y=y + 5,
    width=half - 95,
    height=20,
    borderWidth=0,
    forceBorder=False
)

# Labels
c.setFont("Helvetica", 9)
c.drawString(x + 5, y + 12, "NPI:")
c.drawString(x + half + 5, y + 12, "Entity Name:")

c.save()
buffer.seek(0)

overlay = PdfReader(buffer)

writer = PdfWriter()
writer.append(reader)

# Add the new row to first page
writer.pages[0].merge_page(overlay.pages[0])

# Transfer new editable fields
writer.append_annotations_from_reader(
    overlay,
    after_page_append=lambda page: None
) if hasattr(writer, "append_annotations_from_reader") else None

with open("updated_form.pdf", "wb") as f:
    writer.write(f)

print("Saved updated_form.pdf")
