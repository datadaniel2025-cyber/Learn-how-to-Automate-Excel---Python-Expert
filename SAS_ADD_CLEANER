%macro clean_address(
    input=,
    output=,
    addr1=,
    addr2=
);

data &output;

    /* Final output columns */
    length SAS_Address_1
           SAS_Address_2
           Extra_Group_Name $500;

    /* Temporary character columns */
    length _a1
           _a2
           _candidate_group
           _candidate_address $500;

    /* Regular expression IDs */
    retain _re_start_number
           _re_street
           _re_po_box
           _re_unit
           _re_group
           _re_combined;

    /*
     * Compile regular expressions once.
     */
    if _n_ = 1 then do;

        /* Address starts with a numeric street number */
        _re_start_number = prxparse(
            '/^\s*\d+[A-Z0-9\-\/]*\s+/i'
        );

        /*
         * Street keyword can appear anywhere.
         * It does not need to be at the end.
         */
        _re_street = prxparse(
            '/\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TRL|TRAIL|TER|TERRACE|CIR|CIRCLE|SQ|SQUARE|EXPY|EXPRESSWAY|TPKE|TURNPIKE|PIKE|ROUTE|RTE)\b\.?/i'
        );

        /* PO Box address */
        _re_po_box = prxparse(
            '/\bP\.?\s*O\.?\s+BOX\s+\d+/i'
        );

        /* Suite, apartment, unit, building, floor, etc. */
        _re_unit = prxparse(
            '/^\s*(SUITE|STE|APT|APARTMENT|UNIT|BUILDING|BLDG|FLOOR|FL|ROOM|RM|#)\b/i'
        );

        /* Business or group-name keywords */
        _re_group = prxparse(
            '/\b(INC|LLC|LLP|LTD|CORP|CORPORATION|COMPANY|CO|CENTER|CENTRE|CLINIC|GROUP|HOSPITAL|HEALTH|MEDICAL|ASSOCIATES|ASSOC|PRACTICE|PC|PLLC)\b/i'
        );

        /*
         * Group name and numeric street address combined
         * in the same column.
         */
        _re_combined = prxparse(
            '/\b\d+[A-Z0-9\-]*\s+.*\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TRL|TRAIL|TER|TERRACE|CIR|CIRCLE|ROUTE|RTE)\b/i'
        );

    end;

    set &input;


    /*==========================================================*
     * Clean the original values
     *==========================================================*/

    _a1 = compbl(strip(&addr1));
    _a2 = compbl(strip(&addr2));

    call missing(
        SAS_Address_1,
        SAS_Address_2,
        Extra_Group_Name
    );


    /*==========================================================*
     * Determine whether the values start with a number
     *==========================================================*/

    _a1_starts_number =
        prxmatch(_re_start_number, _a1) > 0;

    _a2_starts_number =
        prxmatch(_re_start_number, _a2) > 0;


    /*==========================================================*
     * Determine whether they contain a street keyword anywhere
     *==========================================================*/

    _a1_has_street_keyword =
        prxmatch(_re_street, _a1) > 0;

    _a2_has_street_keyword =
        prxmatch(_re_street, _a2) > 0;


    /*==========================================================*
     * Determine whether they contain a PO Box
     *==========================================================*/

    _a1_po_box =
        prxmatch(_re_po_box, _a1) > 0;

    _a2_po_box =
        prxmatch(_re_po_box, _a2) > 0;


    /*==========================================================*
     * Final address indicators
     *==========================================================*/

    _a1_is_address =
        _a1_starts_number
        or _a1_has_street_keyword
        or _a1_po_box;

    _a2_is_address =
        _a2_starts_number
        or _a2_has_street_keyword
        or _a2_po_box;


    /*==========================================================*
     * Unit and group-name indicators
     *==========================================================*/

    _a2_is_unit =
        prxmatch(_re_unit, _a2) > 0;

    _a1_is_group =
        prxmatch(_re_group, _a1) > 0;

    _a2_is_group =
        prxmatch(_re_group, _a2) > 0;


    /*==========================================================*
     * Scenario 1:
     * Group name and numeric address combined in Address 1
     *
     * Example:

     *==========================================================*/

    _split_position =
        prxmatch(_re_combined, _a1);

    if _split_position > 1 then do;

        _candidate_group =
            strip(substr(_a1, 1, _split_position - 1));

        _candidate_address =
            strip(substr(_a1, _split_position));

        /*
         * Only split when the beginning contains
         * a group-name keyword.
         */
        if prxmatch(_re_group, _candidate_group) > 0 then do;

            Extra_Group_Name = _candidate_group;
            SAS_Address_1    = _candidate_address;
            SAS_Address_2    = _a2;

        end;

    end;


    /*==========================================================*
     * Process other scenarios if Scenario 1 did not run
     *==========================================================*/

    if missing(SAS_Address_1) then do;


        /*------------------------------------------------------*
         * NEW PRIORITY RULE
         *
         * Address 1 contains a street keyword but does not
         * start with a number.
         *
         * Address 2 starts with a number.
         *
         * Therefore:
         * Address 1 becomes Extra Group Name.
         * Address 2 becomes SAS Address 1.
         *
         * Example:
         * Address 1 = St Joseph Medical Center
         * Address 2 = 123 Main St
         *------------------------------------------------------*/

        if not missing(_a1)
           and _a1_has_street_keyword
           and not _a1_starts_number
           and _a2_starts_number
        then do;

            Extra_Group_Name = _a1;
            SAS_Address_1    = _a2;
            call missing(SAS_Address_2);

        end;


        /*------------------------------------------------------*
         * Address 1 is blank and Address 2 is an address
         *------------------------------------------------------*/

        else if missing(_a1)
             and _a2_is_address
        then do;

            SAS_Address_1 = _a2;
            call missing(SAS_Address_2);

        end;


        /*------------------------------------------------------*
         * Address 1 is not an address, while Address 2
         * contains an address.
         *
         * Examples:
         * Radiation Ming Inc | One Medical Dr
         * Medical Center     | Taylor at Main St
         * ABC Clinic         | 123 Main St
         *------------------------------------------------------*/

        else if not missing(_a1)
             and not _a1_is_address
             and _a2_is_address
        then do;

            Extra_Group_Name = _a1;
            SAS_Address_1    = _a2;
            call missing(SAS_Address_2);

        end;


        /*------------------------------------------------------*
         * Address 1 is already an address
         *------------------------------------------------------*/

        else if _a1_is_address then do;

            SAS_Address_1 = _a1;

            if not missing(_a2) then
                SAS_Address_2 = _a2;

        end;


        /*------------------------------------------------------*
         * Address 1 is a business/group name
         *------------------------------------------------------*/

        else if _a1_is_group then do;

            Extra_Group_Name = _a1;

            if _a2_is_address then do;

                SAS_Address_1 = _a2;
                call missing(SAS_Address_2);

            end;
            else do;

                SAS_Address_2 = _a2;

            end;

        end;


        /*------------------------------------------------------*
         * Address 1 is blank but Address 2 contains data
         *------------------------------------------------------*/

        else if missing(_a1)
             and not missing(_a2)
        then do;

            if _a2_is_group
               and not _a2_is_address
            then
                Extra_Group_Name = _a2;
            else
                SAS_Address_1 = _a2;

        end;


        /*------------------------------------------------------*
         * Final fallback: preserve original values
         *------------------------------------------------------*/

        else do;

            SAS_Address_1 = _a1;
            SAS_Address_2 = _a2;

        end;

    end;


    /*==========================================================*
     * Final safeguard:
     *
     * If SAS Address 1 is blank and SAS Address 2 looks like
     * an address, move SAS Address 2 into SAS Address 1.
     *==========================================================*/

    if missing(SAS_Address_1)
       and not missing(SAS_Address_2)
       and (
            prxmatch(_re_start_number, SAS_Address_2) > 0
            or
            prxmatch(_re_street, SAS_Address_2) > 0
            or
            prxmatch(_re_po_box, SAS_Address_2) > 0
       )
    then do;

        SAS_Address_1 = SAS_Address_2;
        call missing(SAS_Address_2);

    end;


    /*==========================================================*
     * Final cleanup
     *==========================================================*/

    SAS_Address_1 =
        compbl(strip(SAS_Address_1));

    SAS_Address_2 =
        compbl(strip(SAS_Address_2));

    Extra_Group_Name =
        compbl(strip(Extra_Group_Name));


    /* Remove temporary columns */
    drop
        _a1
        _a2
        _candidate_group
        _candidate_address
        _a1_starts_number
        _a2_starts_number
        _a1_has_street_keyword
        _a2_has_street_keyword
        _a1_po_box
        _a2_po_box
        _a1_is_address
        _a2_is_address
        _a2_is_unit
        _a1_is_group
        _a2_is_group
        _split_position
        _re_start_number
        _re_street
        _re_po_box
        _re_unit
        _re_group
        _re_combined;

run;

%mend clean_address;
