%macro clean_address(
    input=,
    output=,
    addr1=,
    addr2=
);

data &output;
    set &input;

    length SAS_Address        $250
           SAS_Address_2      $250
           Extract_Group_Name $250
           _addr1             $250
           _addr2             $250;

    /*====================================================
      COPY ORIGINAL ADDRESS VALUES
    ====================================================*/
    _addr1 = strip(&addr1);
    _addr2 = strip(&addr2);


    /*====================================================
      BASIC CHECKS
    ====================================================*/

    /* Does address start with a number? */
    addr1_start_num =
        prxmatch('/^\s*\d+/', _addr1) > 0;

    addr2_start_num =
        prxmatch('/^\s*\d+/', _addr2) > 0;


    /*====================================================
      FIND NUMBERED STREET ADDRESS INSIDE ADDR1

      Examples:
      ABC MEDICAL 123 MAIN ST
      ABC INC 250 MARKET AVE
    ====================================================*/
    addr1_street_pos = prxmatch(
        '/\b\d+[A-Z]?\s+.*\b(
        ST|STREET|
        AVE|AVENUE|
        RD|ROAD|
        DR|DRIVE|
        BLVD|BOULEVARD|
        LN|LANE|
        CT|COURT|
        CIR|CIRCLE|
        HWY|HIGHWAY|
        PKWY|PARKWAY|
        WAY|
        PL|PLACE|
        TER|TERRACE|
        TRL|TRAIL|
        SQ|SQUARE|
        PLZ|PLAZA
        )\b/i',
        _addr1
    );


    /*====================================================
      FIND NUMBERED STREET ADDRESS INSIDE ADDR2
    ====================================================*/
    addr2_street_pos = prxmatch(
        '/\b\d+[A-Z]?\s+.*\b(
        ST|STREET|
        AVE|AVENUE|
        RD|ROAD|
        DR|DRIVE|
        BLVD|BOULEVARD|
        LN|LANE|
        CT|COURT|
        CIR|CIRCLE|
        HWY|HIGHWAY|
        PKWY|PARKWAY|
        WAY|
        PL|PLACE|
        TER|TERRACE|
        TRL|TRAIL|
        SQ|SQUARE|
        PLZ|PLAZA
        )\b/i',
        _addr2
    );


    /*====================================================
      STREET WORD CHECK

      This handles addresses that DO NOT start with number.

      Example:
      TAYLOR AT MAIN ST
      NORTH BROAD STREET
      MAIN STREET
      PARKWAY WEST
    ====================================================*/

    addr1_has_street_word = prxmatch(
        '/\b(
        ST|STREET|
        AVE|AVENUE|
        RD|ROAD|
        DR|DRIVE|
        BLVD|BOULEVARD|
        LN|LANE|
        CT|COURT|
        CIR|CIRCLE|
        HWY|HIGHWAY|
        PKWY|PARKWAY|
        WAY|
        PL|PLACE|
        TER|TERRACE|
        TRL|TRAIL|
        SQ|SQUARE|
        PLZ|PLAZA
        )\b/i',
        _addr1
    ) > 0;


    addr2_has_street_word = prxmatch(
        '/\b(
        ST|STREET|
        AVE|AVENUE|
        RD|ROAD|
        DR|DRIVE|
        BLVD|BOULEVARD|
        LN|LANE|
        CT|COURT|
        CIR|CIRCLE|
        HWY|HIGHWAY|
        PKWY|PARKWAY|
        WAY|
        PL|PLACE|
        TER|TERRACE|
        TRL|TRAIL|
        SQ|SQUARE|
        PLZ|PLAZA
        )\b/i',
        _addr2
    ) > 0;


    /*====================================================
      CHECK SUITE / UNIT INFORMATION
    ====================================================*/

    addr2_is_unit = prxmatch(
        '/\b(
        SUITE|STE|
        APT|APARTMENT|
        UNIT|
        BLDG|BUILDING|
        FLOOR|FL|
        ROOM|RM
        )\b|#/i',
        _addr2
    ) > 0;


    /*====================================================
      CASE 1

      ADDR1 contains:
      GROUP NAME + STREET ADDRESS

      Example:
      ABC MEDICAL CENTER 123 MAIN ST

      OUTPUT:
      Group = ABC MEDICAL CENTER
      SAS Address = 123 MAIN ST
    ====================================================*/

    if addr1_street_pos > 1 then do;

        Extract_Group_Name =
            strip(substr(_addr1,1,addr1_street_pos-1));

        SAS_Address =
            strip(substr(_addr1,addr1_street_pos));

        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 2

      ADDR1 = normal numbered address

      Example:
      123 MAIN ST
      SUITE 200
    ====================================================*/

    else if addr1_start_num = 1 then do;

        SAS_Address   = _addr1;
        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 3

      ADDR1 = group name
      ADDR2 = numbered address

      Example:
      ABC MEDICAL CENTER
      123 MAIN ST
    ====================================================*/

    else if not missing(_addr1)
        and addr1_start_num = 0
        and addr2_start_num = 1 then do;

        Extract_Group_Name = _addr1;
        SAS_Address        = _addr2;
        SAS_Address_2      = '';

    end;


    /*====================================================
      CASE 4

      ADDR1 blank
      ADDR2 = numbered address
    ====================================================*/

    else if missing(_addr1)
        and addr2_start_num = 1 then do;

        SAS_Address   = _addr2;
        SAS_Address_2 = '';

    end;


    /*====================================================
      CASE 5

      ADDR1 = group name
      ADDR2 contains numbered street address
      somewhere inside the value
    ====================================================*/

    else if not missing(_addr1)
        and addr2_street_pos > 0 then do;

        Extract_Group_Name = _addr1;
        SAS_Address        = _addr2;
        SAS_Address_2      = '';

    end;


    /*====================================================
      CASE 6

      NEW IMPORTANT CASE

      Neither one starts with a number,
      but ADDR2 contains street keyword.

      Example:

      ADDR1 = MEDICAL CENTER
      ADDR2 = TAYLOR AT MAIN ST

      OUTPUT:
      Group = MEDICAL CENTER
      SAS Address = TAYLOR AT MAIN ST
    ====================================================*/

    else if not missing(_addr1)
        and addr1_start_num = 0
        and addr2_start_num = 0
        and addr2_has_street_word = 1 then do;

        Extract_Group_Name = _addr1;
        SAS_Address        = _addr2;
        SAS_Address_2      = '';

    end;


    /*====================================================
      CASE 7

      ADDR1 itself does not start with number,
      but contains street keyword.

      Example:
      NORTH MAIN ST

      Treat ADDR1 as address.
    ====================================================*/

    else if addr1_has_street_word = 1 then do;

        SAS_Address   = _addr1;
        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 8

      Cannot confidently identify an address.

      Preserve the data instead of deleting it.
    ====================================================*/

    else do;

        Extract_Group_Name = _addr1;
        SAS_Address        = '';
        SAS_Address_2      = _addr2;

    end;


    /*====================================================
      REMOVE TEMPORARY VARIABLES
    ====================================================*/

    drop _addr1
         _addr2
         addr1_start_num
         addr2_start_num
         addr1_street_pos
         addr2_street_pos
         addr1_has_street_word
         addr2_has_street_word
         addr2_is_unit;

run;

%mend;
