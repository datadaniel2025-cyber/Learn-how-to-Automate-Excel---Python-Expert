%macro clean_address(
    input=,
    output=,
    addr1=,
    addr2=
);

data &output;
    set &input;

    length SAS_Address        $250
           SAS_Address_2      $250
           Extract_Group_Name $250
           _addr1             $250
           _addr2             $250;

    /*====================================================
      COPY ORIGINAL VALUES
    ====================================================*/
    _addr1 = strip(&addr1);
    _addr2 = strip(&addr2);


    /*====================================================
      STARTS WITH NUMBER?
    ====================================================*/
    addr1_start_num = prxmatch('/^\s*\d+/', _addr1) > 0;
    addr2_start_num = prxmatch('/^\s*\d+/', _addr2) > 0;


    /*====================================================
      FIND NUMBERED STREET ADDRESS ANYWHERE
    ====================================================*/
    addr1_street_pos = prxmatch(
        '/\b\d+[A-Z]?\s+.*\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|CIR|CIRCLE|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TER|TERRACE|TRL|TRAIL|SQ|SQUARE|PLZ|PLAZA)\b/i',
        _addr1
    );

    addr2_street_pos = prxmatch(
        '/\b\d+[A-Z]?\s+.*\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|CIR|CIRCLE|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TER|TERRACE|TRL|TRAIL|SQ|SQUARE|PLZ|PLAZA)\b/i',
        _addr2
    );


    /*====================================================
      STREET KEYWORD CHECK
    ====================================================*/
    addr1_has_street_word = prxmatch(
        '/\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|CIR|CIRCLE|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TER|TERRACE|TRL|TRAIL|SQ|SQUARE|PLZ|PLAZA)\b/i',
        _addr1
    ) > 0;

    addr2_has_street_word = prxmatch(
        '/\b(ST|STREET|AVE|AVENUE|RD|ROAD|DR|DRIVE|BLVD|BOULEVARD|LN|LANE|CT|COURT|CIR|CIRCLE|HWY|HIGHWAY|PKWY|PARKWAY|WAY|PL|PLACE|TER|TERRACE|TRL|TRAIL|SQ|SQUARE|PLZ|PLAZA)\b/i',
        _addr2
    ) > 0;


    /*====================================================
      CASE 1
      ADDR1 = GROUP NAME + STREET ADDRESS

      ABC INC 123 MAIN ST
    ====================================================*/
    if addr1_street_pos > 1 then do;

        Extract_Group_Name =
            strip(substr(_addr1,1,addr1_street_pos-1));

        SAS_Address =
            strip(substr(_addr1,addr1_street_pos));

        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 2
      ADDR1 DOES NOT START WITH NUMBER
      ADDR2 CONTAINS STREET KEYWORD

      CHESTER MUSIC INC
      YALOR INC DR

      MEDICAL CENTER
      TAYLOR AT MAIN ST
    ====================================================*/
    else if addr1_start_num = 0
        and not missing(_addr2)
        and addr2_has_street_word = 1 then do;

        Extract_Group_Name = _addr1;
        SAS_Address        = _addr2;
        SAS_Address_2      = '';

    end;


    /*====================================================
      CASE 3
      ADDR1 = GROUP NAME
      ADDR2 STARTS WITH NUMBER

      ABC MEDICAL
      123 MAIN ST
    ====================================================*/
    else if addr1_start_num = 0
        and not missing(_addr1)
        and addr2_start_num = 1 then do;

        Extract_Group_Name = _addr1;
        SAS_Address        = _addr2;
        SAS_Address_2      = '';

    end;


    /*====================================================
      CASE 4
      ADDR1 IS NORMAL NUMBERED ADDRESS

      123 MAIN ST
      SUITE 200
    ====================================================*/
    else if addr1_start_num = 1 then do;

        SAS_Address   = _addr1;
        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 5
      ADDR1 BLANK
      ADDR2 STARTS WITH NUMBER
    ====================================================*/
    else if missing(_addr1)
        and addr2_start_num = 1 then do;

        SAS_Address   = _addr2;
        SAS_Address_2 = '';

    end;


    /*====================================================
      CASE 6
      ADDR1 BLANK
      ADDR2 HAS STREET KEYWORD
    ====================================================*/
    else if missing(_addr1)
        and addr2_has_street_word = 1 then do;

        SAS_Address   = _addr2;
        SAS_Address_2 = '';

    end;


    /*====================================================
      CASE 7
      ADDR1 DOES NOT START WITH NUMBER
      BUT ADDR1 ITSELF HAS STREET KEYWORD

      NORTH MAIN ST
    ====================================================*/
    else if addr1_has_street_word = 1 then do;

        SAS_Address   = _addr1;
        SAS_Address_2 = _addr2;

    end;


    /*====================================================
      CASE 8
      NOTHING CLEARLY LOOKS LIKE ADDRESS
    ====================================================*/
    else do;

        Extract_Group_Name = _addr1;
        SAS_Address        = '';
        SAS_Address_2      = _addr2;

    end;


    /*====================================================
      DROP TEMP VARIABLES
    ====================================================*/
    drop _addr1
         _addr2
         addr1_start_num
         addr2_start_num
         addr1_street_pos
         addr2_street_pos
         addr1_has_street_word
         addr2_has_street_word;

run;

%mend;
