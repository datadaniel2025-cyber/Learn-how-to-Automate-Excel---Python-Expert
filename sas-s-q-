/*============================================================
  STEP 1: Allow SAS to read Excel column names with spaces
============================================================*/
options validvarname=any;


/*============================================================
  STEP 2: Set file locations
============================================================*/

%let source_file = /your/path/source_file.xlsx;
%let xwalk_file  = /your/path/xwalk_file.xlsx;


/*============================================================
  STEP 3: Read SOURCE file
============================================================*/

proc import datafile="&source_file."
    out=work.source
    dbms=xlsx
    replace;
    getnames=yes;
run;


/*============================================================
  STEP 4: Read XWALK file
============================================================*/

proc import datafile="&xwalk_file."
    out=work.xwalk
    dbms=xlsx
    replace;
    getnames=yes;
run;


/*============================================================
  STEP 5: LEFT JOIN
============================================================*/

proc sql;

    create table work.provider_final as

    select
        a.*,
        b.Specialty

    from work.source as a

    left join work.xwalk as b

        on strip(a.'Taxonomy Code (Primary Specialty)'n)
         =
           strip(b.'Taxonomy Code'n);

quit;


/*============================================================
  STEP 6: Check the result
============================================================*/

proc print data=work.provider_final(obs=20);
run;
